{
  "name": "paperpath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma migrate deploy",
    "dev": "next dev",
    "prebuild": "prisma migrate deploy",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:questions": "tsx scripts/sync-questions.mjs",
    "db:tester": "tsx scripts/create-tester.mjs",
    "db:import-topic": "tsx scripts/import-topic.mjs",
    "db:remove-topic": "tsx scripts/remove-topic.mjs",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "tsx --conditions=react-server --test \"tests/**/*.test.ts\"",
    "verify": "node scripts/verify.mjs",
    "verify:tutor": "node scripts/verify-tutor.mjs",
    "verify:guided": "node scripts/verify-guided.mjs",
    "verify:grounding": "node scripts/verify-grounding.mjs",
    "verify:payments": "tsx scripts/verify-payments.mjs",
    "verify:expression": "tsx scripts/verify-expression.mjs",
    "verify:tools": "node scripts/verify-tools.mjs",
    "verify:staff": "node scripts/verify-staff.mjs",
    "mock:openai": "node scripts/mock-openai.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.0",
    "jose": "^6.2.8",
    "katex": "^0.18.4",
    "ketcher-react": "^3.17.2",
    "ketcher-standalone": "^3.17.2",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "openai": "^7.4.0",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/schema-engine-wasm": "^7.10.0-7.561d7b42579a2459cc8edf3788918b626c640023",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
