// PaperPath — Prisma 7 schema
// Connection URL lives in prisma.config.ts (Prisma 7 removed `url` from datasource).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  PARENT
  /// Authors content: courses, chapters, topics and exam questions. Cannot
  /// change the catalog structure (classes, subjects) or anyone's role.
  TEACHER
  ADMIN
}

enum Stream {
  GENERAL
  COMMERCE
  SCIENCE
}

enum TopicKind {
  VIDEO
  ACTIVITY
}

enum SubscriptionScope {
  COURSE // one subject for one class
  CLASS // every subject in a class ("Complete Class 8")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ChatMode {
  TUTOR
  CAREER
  /// Topic-locked, step-by-step practice. Answers come back structured rather
  /// than as prose, and the model may only use material the staff supplied.
  GUIDED
}

enum QuestionKind {
  MCQ
  NUMERIC
  SHORT
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum CreditReason {
  DAILY_GRANT
  TUTOR_MESSAGE
  MANUAL_ADJUSTMENT
}

enum RefundRequestStatus {
  REQUESTED
  APPROVED
  DECLINED
  /// The provider accepted the refund but has not confirmed it yet. The
  /// subscription is only cancelled when the refund webhook arrives, so this
  /// state exists to stop a second approval being sent in the meantime.
  SENT
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Board {
  id        String       @id @default(cuid())
  code      String       @unique // CBSE, ICSE, MH, TN...
  name      String
  createdAt DateTime     @default(now())
  classes   ClassLevel[]
  users     User[]

  @@index([code])
}

model ClassLevel {
  id      String  @id @default(cuid())
  boardId String
  slug    String // class-8, class-11-commerce
  label   String // "Class - 8th"
  grade   Int // 5..12
  stream  Stream  @default(GENERAL)
  sortKey Int     @default(0)
  /// Price in paise for the bundled "all subjects" plan. Null = not sold as a bundle.
  bundlePricePaise Int?
  /// Sum of individual subject prices, used to render "Save ₹X vs buying separately".
  bundleListPricePaise Int?

  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  courses Course[]
  users   User[]
  /// Bundle subscriptions scoped to this class. Restricted rather than
  /// cascading: `classLevelId` used to be a bare string with no constraint at
  /// all, so deleting a class left live subscriptions pointing at nothing —
  /// rows that granted access to a class the catalog no longer had.
  subscriptions Subscription[]
  payments      Payment[]

  @@unique([boardId, slug])
  @@index([boardId, sortKey])
}

model Subject {
  id        String   @id @default(cuid())
  slug      String   @unique // maths, science, ai-gen-ai
  name      String
  icon      String   @default("book") // lucide-ish key rendered by the UI
  colorFrom String   @default("#F59E0B")
  colorTo   String   @default("#EA580C")
  sortKey   Int      @default(0)
  createdAt DateTime @default(now())

  courses Course[]
}

/// A Course is the sellable unit: one Subject for one ClassLevel.
model Course {
  id           String @id @default(cuid())
  classLevelId String
  subjectId    String
  pricePaise   Int    @default(0)
  sortKey      Int    @default(0)

  classLevel    ClassLevel     @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapters      Chapter[]
  subscriptions Subscription[]
  payments      Payment[]

  @@unique([classLevelId, subjectId])
  @@index([classLevelId, sortKey])
}

model Chapter {
  id       String  @id @default(cuid())
  courseId String
  index    Int // 1-based, as shown in the UI
  title    String
  /// Chapter 1 of every course is free — mirrors the live product's rule.
  isFree   Boolean @default(false)
  summary  String?

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics       Topic[]
  chatSessions ChatSession[]
  questions    Question[]
  attempts     QuizAttempt[]
  bookmarks    Bookmark[]

  @@unique([courseId, index])
  @@index([courseId, index])
}

model Topic {
  id          String    @id @default(cuid())
  chapterId   String
  index       Int
  title       String
  kind        TopicKind @default(VIDEO)
  durationSec Int       @default(0)
  /// HLS manifest or MP4. Null while the lesson is still being produced.
  videoUrl    String?
  posterUrl   String?
  /// The only material the guided tutor may answer from for this topic. Null or
  /// empty means the topic is not offered for guided practice at all — which is
  /// the point: a topic nobody has written material for cannot be grounded, and
  /// an ungrounded "grounded" answer is the failure this whole mode exists to
  /// prevent.
  content     String?

  chapter  Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress     Progress[]
  notes        Note[]
  answers      TopicAnswer[]
  chatSessions ChatSession[]

  @@unique([chapterId, index])
  @@index([chapterId, index])
}

/// A question with the answer the client wants given for it, word for word.
///
/// This is what makes "exact answer" a fact rather than a hope. The model is
/// shown these pairs and asked which one the student is asking; when it names
/// one, the server substitutes the stored answer for whatever the model wrote.
/// The model's remaining job is the explanation, where being fluent is what we
/// actually want from it.
model TopicAnswer {
  id        String   @id @default(cuid())
  topicId   String
  index     Int
  question  String
  answer    String
  /// Pre-written steps, one per element. Empty means the model writes them.
  steps     String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, index])
  @@index([topicId, index])
}

// ---------------------------------------------------------------------------
// Assessment
// ---------------------------------------------------------------------------

model Question {
  id          String       @id @default(cuid())
  chapterId   String
  index       Int
  kind        QuestionKind @default(MCQ)
  prompt      String
  /// Choices in display order. Empty for NUMERIC and SHORT questions.
  options     String[]
  /// For MCQ this is the 0-based index into `options`, as a string. For NUMERIC
  /// and SHORT it is the expected value, compared case- and space-insensitively.
  /// Never sent to the client until the attempt has been submitted.
  answer      String
  explanation String?
  /// 1 easy, 2 medium, 3 hard.
  difficulty  Int          @default(1)
  marks       Int          @default(1)

  chapter Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([chapterId, index])
  @@index([chapterId, index])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  userId      String
  chapterId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int       @default(0)
  maxScore    Int       @default(0)

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([userId, chapterId])
  @@index([userId, submittedAt])
}

model QuizAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  given      String
  correct    Boolean @default(false)

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

// ---------------------------------------------------------------------------
// Study aids
// ---------------------------------------------------------------------------

model Note {
  id        String   @id @default(cuid())
  userId    String
  topicId   String
  body      String
  /// Playback position the note was taken at, so it can jump back into the video.
  atSec     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId, topicId])
  @@index([userId, createdAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  chapterId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// People, access, progress
// ---------------------------------------------------------------------------

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           Role     @default(STUDENT)
  language       String   @default("en-IN")
  boardId        String?
  classLevelId   String?
  /// Remaining AI-tutor messages for the current day.
  dailyCredits   Int      @default(5)
  dailyCreditCap Int      @default(5)
  /// UTC start of the day the credits were last granted for.
  creditsGrantedOn DateTime?
  /// When the account holder confirmed parent/guardian permission. Null for
  /// accounts created before the consent gate existed.
  ///
  /// This is the child ticking a box, which is not verifiable consent under the
  /// DPDP Act 2023 — a box is exactly as easy for the child to tick as it is
  /// for the parent. `guardianConsentAt` below is the half that involves the
  /// parent at all.
  consentAcceptedAt DateTime?
  /// The address a consent request was sent to, if one was given at signup.
  guardianEmail     String?
  /// When the guardian confirmed, by following a link mailed to that address.
  /// Reaching an inbox the child named is weaker than a government ID check and
  /// stronger than a checkbox; whether it satisfies DPDP is a question for a
  /// lawyer, not for this comment.
  guardianConsentAt DateTime?
  /// When the address was proved reachable by following a mailed link. Null
  /// means unverified — the account works, but with a reduced credit cap and a
  /// banner, so a typo'd or borrowed address cannot farm the free allowance.
  emailVerifiedAt   DateTime?
  /// A test account: the guided-practice screen and nothing else.
  ///
  /// Not a Role, because it is orthogonal to one — this is still a STUDENT, and
  /// every role check elsewhere should keep treating it as one. What it changes
  /// is the surface: the navigation, the pages the layout will render, and the
  /// tutor routes that would otherwise let a tester wander into the paid
  /// product they are not here to test.
  testMode          Boolean  @default(false)
  /// Bumped to invalidate every session token already issued for this user.
  /// Session cookies carry the value they were signed with, so a mismatch on
  /// the next request logs the holder out — that is what makes "sign out
  /// everywhere", and the sign-out implied by a password reset, actually work.
  tokenVersion      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  board         Board?         @relation(fields: [boardId], references: [id], onDelete: SetNull)
  classLevel    ClassLevel?    @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  progress      Progress[]
  chatSessions  ChatSession[]
  credits       CreditLedger[]
  payments      Payment[]
  resetTokens   PasswordResetToken[]
  verifyTokens  EmailVerificationToken[]
  quizAttempts  QuizAttempt[]
  notes         Note[]
  bookmarks     Bookmark[]
  refundRequests RefundRequest[]
  guardianTokens GuardianConsentToken[]
  /// Children this account can see the progress of.
  children      ParentLink[]           @relation("ParentOf")
  /// Adults who can see this account's progress.
  guardians     ParentLink[]           @relation("ChildOf")

  @@index([email])
}

/// Single-use, time-limited password reset. Only the hash is stored, so a leaked
/// database row cannot be replayed as a reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use, time-limited parent/guardian consent. Same shape as the other
/// two token tables, for the same reason: the raw value travels through email
/// and is a bearer credential, so only its hash is stored.
model GuardianConsentToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// An adult who may see one child's progress.
///
/// Read-only by design, and separate from the child's own login: a parent
/// following along must not be able to spend the child's tutor credits, take
/// their quizzes, or read their tutor conversations, which is why the family
/// view queries progress and attempts rather than signing anyone in as anyone.
model ParentLink {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  User @relation("ParentOf", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("ChildOf", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

/// Single-use, time-limited email confirmation. Stored and compared exactly like
/// PasswordResetToken — only the hash is kept, so a leaked row is not a link.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String
  scope        SubscriptionScope
  status       SubscriptionStatus @default(ACTIVE)
  /// Set when scope = COURSE. Null for a CLASS-wide bundle.
  courseId     String?
  /// Set when scope = CLASS.
  classLevelId String?
  pricePaise   Int                @default(0)
  startsAt     DateTime           @default(now())
  endsAt       DateTime
  createdAt    DateTime           @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade. Deleting a course used to silently delete the
  /// subscriptions people had paid for it — the admin panel guards against it,
  /// but the database should refuse it too, because a guard is a policy and a
  /// constraint is a fact.
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  classLevel ClassLevel? @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  payment    Payment?

  @@index([userId, status])
  @@index([courseId])
  @@index([classLevelId])
}

/// One row per checkout attempt. Created before the user is sent to the payment
/// provider and only flipped to PAID by a signature-verified webhook — the
/// Subscription is created at that moment, never from a client callback.
model Payment {
  id           String            @id @default(cuid())
  userId       String
  scope        SubscriptionScope
  courseId     String?
  classLevelId String?
  amountPaise  Int
  currency     String            @default("INR")
  status       PaymentStatus     @default(CREATED)
  provider     String            @default("razorpay")
  /// Provider's order id. Unique so a replayed webhook cannot grant twice.
  providerOrderId   String  @unique
  providerPaymentId String?
  /// Set once a subscription has been granted for this payment.
  subscriptionId    String? @unique
  failureReason     String?
  /// Set when the provider tells us the money went back. The subscription this
  /// payment bought is cancelled at the same moment — otherwise a refunded
  /// student keeps the full year of access they no longer paid for.
  refundedAt        DateTime?
  refundedPaise     Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  refundRequests RefundRequest[]
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  /// SetNull rather than Restrict: a payment is a financial record and has to
  /// survive the catalog being reorganised, but it must not keep pointing at a
  /// course or class that no longer exists.
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  classLevel   ClassLevel?   @relation(fields: [classLevelId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([courseId])
  @@index([classLevelId])
}

/// A student asking for the refund the terms promise.
///
/// /terms offers a full refund within seven days of purchase, and there was no
/// way to ask for one: the only route was for an operator to notice an email
/// and issue it by hand in the Razorpay dashboard. This is the record of the
/// ask, so a promise made in writing has somewhere to land — and so a decision
/// on it is auditable rather than a message in somebody's inbox.
///
/// Approving does not itself take access away. It sends the refund to the
/// provider; the refund webhook is still the only thing that revokes, which
/// keeps one path into `revokeForPayment` rather than two.
model RefundRequest {
  id        String              @id @default(cuid())
  paymentId String
  userId    String
  reason    String
  status    RefundRequestStatus @default(REQUESTED)
  /// What the staff member decided and why — shown back to the student.
  decisionNote String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([paymentId])
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  topicId     String
  positionSec Int      @default(0)
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// AI tutor
// ---------------------------------------------------------------------------

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  /// Scopes the system prompt to a chapter. Null = general "Ask Questions" session.
  chapterId String?
  /// Set for GUIDED sessions: the one topic this conversation may draw on.
  topicId   String?
  /// Which system prompt this session runs under. CAREER sessions are kept
  /// separate so career advice and homework help don't bleed into each other.
  mode      ChatMode @default(TUTOR)
  title     String   @default("New session")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter  Chapter?      @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  topic    Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@index([userId, topicId, updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      ChatRole
  /// The answer itself. In a GUIDED session this is the headline answer only —
  /// short, and exactly what the client's answer key says where there is one.
  content   String
  /// The working, one step per element, revealed one at a time by the guided
  /// UI. Empty for every other mode.
  steps     String[] @default([])
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model CreditLedger {
  id        String       @id @default(cuid())
  userId    String
  delta     Int
  reason    CreditReason
  note      String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  /// Counts today's TUTOR_MESSAGE rows across every account, which is how the
  /// deployment-wide daily model budget is measured. Without it that count
  /// scans the whole ledger, and the ledger only ever grows.
  @@index([reason, createdAt])
}
