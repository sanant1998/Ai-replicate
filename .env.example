# Copy to .env and fill in. Only the first two blocks are required to boot.

# --- Database ----------------------------------------------------------------
# Pooled endpoint (on Neon the host contains "-pooler") — used by the app.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Direct endpoint (no pooler) — used by migrations and seeding, since DDL
# through a transaction pooler is unreliable. See prisma.config.ts. On a plain
# local Postgres, leave this unset.
DIRECT_DATABASE_URL=

# --- Auth --------------------------------------------------------------------
# Signs session cookies and video playback tickets. Generate with:
#   openssl rand -base64 32
# Changing it signs everyone out and invalidates every issued playback ticket.
AUTH_SECRET=

# Absolute origin used to build links inside emails (password reset, email
# confirmation) and the sitemap. Set this in production: without it the links
# are derived from the Host header, which the caller controls.
APP_ORIGIN=http://localhost:3000

# --- Deployment --------------------------------------------------------------
# Set to 1 only when the app sits behind a reverse proxy that overwrites
# x-forwarded-for. Unset behind no proxy: believing a forgeable header lets a
# client hand itself a fresh rate-limit bucket per request. On Vercel this is
# unnecessary — x-vercel-forwarded-for is trusted automatically.
# TRUST_PROXY=1

# Shared rate-limit counters. Without these the limiter is per-process, which
# means per-instance on a scaled deploy and per-cold-start on serverless.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Authorises GET /api/cron/maintenance. Unset, that route refuses to run.
# CRON_SECRET=

# Where runtime failures are announced, on top of the structured log line every
# error already writes. A Slack incoming webhook works as-is (it renders the
# `text` field); so does anything else that accepts JSON. Capped at 5 messages
# per scope per 10 minutes, so an outage cannot flood the channel it needs.
# Swap src/lib/observability.ts for a real APM when you want one — everything
# already reports through that single function.
# ERROR_WEBHOOK_URL=

# Space-separated origins the video player may stream from, for the CSP in
# src/proxy.ts. Set this when you point upstreamUrl() at a real CDN.
# MEDIA_ORIGINS=https://test-streams.mux.dev

# --- AI tutor ----------------------------------------------------------------
# Without a key /tutor fails closed with a 503 rather than crashing.
# For local work without spending credits: `npm run mock:openai`, then use
# OPENAI_API_KEY=mock with OPENAI_BASE_URL=http://127.0.0.1:4010/v1
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# Model calls the whole deployment may make in one UTC day, across every
# account. The per-account credit cap bounds one student; this bounds the bill,
# which the per-account cap cannot do while signup is free. Defaults to 200.
# Prefer a spend limit on the OpenAI account itself where you can set one — this
# is the backstop for when you cannot. Set to 0 to remove the ceiling.
# TUTOR_DAILY_LIMIT=200

# --- Payments (Razorpay) -----------------------------------------------------
# With these unset /checkout refuses to sell rather than granting anything.
# Register the webhook URL /api/payments/razorpay/webhook in the dashboard.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Restores the grant-without-charging path for local work. Ignored in a
# production build.
# ALLOW_MOCK_CHECKOUT=1

# --- Receipts ----------------------------------------------------------------
# What /receipt/[paymentId] is allowed to claim. With SELLER_GSTIN set it issues
# a tax invoice carrying a GST breakdown; without it, a plain payment receipt.
# Showing a tax component with no registration behind it is an offence in India,
# not a formatting choice — so this is opt-in on purpose.
# SELLER_LEGAL_NAME=PaperPath Learning Pvt Ltd
# SELLER_ADDRESS=12 Example Road, Pune 411001
# SELLER_GSTIN=27AAAAA0000A1Z5
# SELLER_STATE=Maharashtra
# The rate applied to a tax invoice. Defaults to 18. Online educational content
# is rated differently depending on exactly what is sold and to whom — ask an
# accountant rather than trusting this default.
# GST_PERCENT=18

# --- Email -------------------------------------------------------------------
# Two options; SMTP wins if both are set. With neither, password-reset and
# confirmation links are logged to the server console instead of sent — fine for
# development, silently broken for real users.
#
# SMTP. In development point this at Mailtrap's sandbox, which captures mail in
# a web inbox rather than delivering it — the test accounts use real-looking
# addresses, and this app's users are children.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASSWORD=

# Resend's HTTP API, as an alternative to SMTP.
# RESEND_API_KEY=

# EMAIL_FROM=PaperPath <no-reply@yourdomain.com>
